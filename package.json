{
	"name": "clar",
	"version": "0.1.3",
	"description": "Adds a Kanban Board view for Obsidian Bases.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"prelint": "node scripts/check-node.mjs",
		"lint": "eslint .",
		"setup-test-vault": "node scripts/setup-test-vault.mjs",
		"pretest:unit": "node scripts/check-node.mjs",
		"test:unit": "vitest run",
		"test:e2e": "npm run build && wdio run ./wdio.conf.mts",
		"test": "npm run lint && npm run test:unit && npm run test:e2e"
	},
	"keywords": [],
	"license": "agpl-3.0",
	"engines": {
		"node": ">=26"
	},
	"dependencies": {
		"sortablejs": "^1.15.6"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/mocha": "^10.0.10",
		"@types/node": "^22.15.17",
		"@types/sortablejs": "^1.15.8",
		"@wdio/cli": "^10.0.2",
		"@wdio/globals": "^10.0.2",
		"@wdio/local-runner": "^10.0.2",
		"@wdio/mocha-framework": "^10.0.1",
		"esbuild": "^0.27.0",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.1.8",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"mocha": "^12.0.3",
		"obsidian": "latest",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.71.2",
		"vitest": "^5.0.5",
		"wdio-obsidian-reporter": "^3.3.0",
		"wdio-obsidian-service": "^3.3.0",
		"webdriverio": "^10.0.2"
	},
	"overrides": {
		"wdio-obsidian-service": {
			"webdriverio": "$webdriverio"
		}
	}
}
